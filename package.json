{
	"name": "ulik.no",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "node scripts/dev.js",
		"build": "elm-watch make --optimize && vite build && node scripts/prerender.js",
		"preview": "vite preview",
		"check": "elm make src/elm/Main.elm --output=/dev/null && node scripts/check.js",
		"check:watch": "elm-watch hot",
		"lint": "elm-format src/elm tests --validate && biome check .",
		"format": "elm-format src/elm tests --yes && biome format --write .",
		"test": "node scripts/test.js",
		"test:e2e": "playwright test"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.15",
		"@playwright/test": "^1.63.0",
		"@vitest/coverage-v8": "^5.0.3",
		"vite": "^8.3.2",
		"vitest": "^5.0.3",
		"elm": "0.19.1-6",
		"elm-watch": "1.2.8",
		"elm-format": "0.8.8",
		"elm-test": "0.19.1-revision17",
		"jsdom": "^30.1.1"
	},
	"dependencies": {
		"diff": "^9.0.0",
		"three": "^0.186.1"
	}
}
